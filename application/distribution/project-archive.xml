<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>project</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>doomed-corridors</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <excludes>
                <exclude>.git/**</exclude>
                <exclude>.idea/**</exclude>
                <exclude>.settings/**</exclude>
                <exclude>.vscode/**</exclude>
                <exclude>target/**</exclude>
                <exclude>target_test-classes/**</exclude>
                <exclude>.classpath</exclude>
                <exclude>.project</exclude>
                <exclude>*.code-workspace</exclude>
                <exclude>*.iml</exclude>
                <exclude>**/.DS_Store</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/import-cache</directory>
            <outputDirectory>doomed-corridors/target/import-cache</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
        </fileSet>
    </fileSets>
</assembly>
