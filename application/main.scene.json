{
  "$schema": "../schema/scene-1.schema.json",
  "schemaVersion": 1,
  "id": "main",
  "root": {
    "id": "world",
    "name": "World",
    "type": "io.github.glynch.jscene3d/group-3d",
    "typeVersion": 1,
    "properties": {
      "background": "#000000"
    },
    "children": [
      {
        "id": "level",
        "name": "MAP01",
        "type": "io.github.glynch.doomed-corridors/doom-level-3d",
        "typeVersion": 1,
        "properties": {
          "map": {"$ref": "import:freedoom-maps/maps/MAP01"},
          "materials": {
            "$ref": "import:freedoom-map-materials/materials/MAP01"
          }
        },
        "children": [
          {
            "id": "player",
            "name": "Player",
            "type": "io.github.glynch.jscene3d/character-body-3d",
            "typeVersion": 1,
            "properties": {
              "gravity": 18,
              "jump-speed": 0,
              "maximum-step-height": 0.75,
              "ground-snap-distance": 0.25
            },
            "controller": {
              "type": "io.github.glynch.doomed-corridors/doom-player-controller",
              "typeVersion": 1,
              "properties": {
                "camera-node": "camera",
                "pointer-sensitivity": 0.002,
                "move-speed": 8,
                "turn-speed-degrees": 180,
                "maximum-pitch-degrees": 85
              }
            },
            "children": [
              {
                "id": "player-shape",
                "name": "Player Collision",
                "type": "io.github.glynch.jscene3d/collision-shape-3d",
                "typeVersion": 1,
                "properties": {
                  "shape": {"$ref": "project:application/player.shape.json"}
                }
              },
              {
                "id": "camera",
                "name": "Player Camera",
                "type": "io.github.glynch.jscene3d/perspective-camera-3d",
                "typeVersion": 1,
                "properties": {
                  "position": [0, 0, 0],
                  "target": [1, 0, 0],
                  "near": 0.05,
                  "far": 256,
                  "active": true
                }
              }
            ]
          },
          {
            "id": "static-collision",
            "name": "Static Collision",
            "type": "io.github.glynch.jscene3d/static-body-3d",
            "typeVersion": 1,
            "children": [
              {
                "id": "level-shape",
                "name": "Level Shape",
                "type": "io.github.glynch.jscene3d/collision-shape-3d",
                "typeVersion": 1,
                "properties": {
                  "shape": {
                    "$ref": "import:freedoom-maps/maps/MAP01/static-collision"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
