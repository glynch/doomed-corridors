{
  "$schema": "https://jscene3d.org/schemas/input-map-1.json",
  "schemaVersion": 1,
  "actions": {
    "move": {
      "valueType": "axis-2d",
      "bindings": [
        {
          "device": "keyboard",
          "control": "directional",
          "up": "W",
          "down": "S",
          "left": "A",
          "right": "D"
        },
        {"device": "gamepad", "control": "left-stick", "deadZone": 0.15, "invertY": true}
      ]
    },
    "look": {
      "valueType": "axis-2d",
      "bindings": [
        {"device": "mouse", "control": "delta", "scaleX": 1, "scaleY": -1},
        {"device": "gamepad", "control": "right-stick", "deadZone": 0.15, "invertY": true}
      ]
    },
    "turn-left": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "LEFT"}
      ]
    },
    "turn-right": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "RIGHT"}
      ]
    },
    "interact": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "E"},
        {"device": "gamepad", "control": "button-west"}
      ]
    },
    "fire-primary": {
      "valueType": "button",
      "bindings": [
        {"device": "mouse", "control": "LEFT"},
        {"device": "gamepad", "control": "button-south"}
      ]
    },
    "select-pistol": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "DIGIT_1"}
      ]
    },
    "select-shotgun": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "DIGIT_2"}
      ]
    },
    "menu-previous": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "UP"},
        {"device": "keyboard", "control": "W"},
        {"device": "gamepad", "control": "dpad-up"}
      ]
    },
    "menu-next": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "DOWN"},
        {"device": "keyboard", "control": "S"},
        {"device": "gamepad", "control": "dpad-down"}
      ]
    },
    "menu-confirm": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "ENTER"},
        {"device": "gamepad", "control": "button-south"}
      ]
    },
    "menu": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "ESCAPE"},
        {"device": "gamepad", "control": "start"}
      ]
    }
  }
}
