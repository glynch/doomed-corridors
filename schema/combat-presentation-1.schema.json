{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/doomed-corridors/combat-presentation-1.json",
  "title": "Doomed Corridors combat presentation version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "weapon", "combatants", "hud"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "weapon": { "$ref": "#/$defs/weapon" },
    "combatants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/combatant" }
    },
    "hud": { "$ref": "#/$defs/hud" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "lump": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,8}$"
    },
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "readyFrame", "fireFrames", "frameMilliseconds", "fireSound"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "readyFrame": { "$ref": "#/$defs/lump" },
        "fireFrames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lump" }
        },
        "frameMilliseconds": { "type": "integer", "minimum": 1 },
        "fireSound": { "$ref": "#/$defs/lump" }
      }
    },
    "combatant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "painFrames", "deathFrames", "frameMilliseconds", "painSound", "deathSounds"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "painFrames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lump" }
        },
        "deathFrames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lump" }
        },
        "frameMilliseconds": { "type": "integer", "minimum": 1 },
        "painSound": { "$ref": "#/$defs/lump" },
        "deathSounds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lump" }
        }
      }
    },
    "hud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digits", "percent"],
      "properties": {
        "digits": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/lump" }
        },
        "percent": { "$ref": "#/$defs/lump" }
      }
    }
  }
}
