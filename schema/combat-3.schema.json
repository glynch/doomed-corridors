{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/doomed-corridors/combat-3.json",
  "title": "Doomed Corridors combat rules version 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "player", "weapons", "combatants", "pickups"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 3 },
    "player": { "$ref": "#/$defs/player" },
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/weapon" }
    },
    "combatants": {
      "type": "array",
      "items": { "$ref": "#/$defs/combatant" }
    },
    "pickups": {
      "type": "array",
      "items": { "$ref": "#/$defs/pickup" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startingHealth",
        "maximumHealth",
        "startingBullets",
        "maximumBullets",
        "startingWeapon"
      ],
      "properties": {
        "startingHealth": { "type": "integer", "minimum": 1 },
        "maximumHealth": { "type": "integer", "minimum": 1 },
        "startingBullets": { "type": "integer", "minimum": 0 },
        "maximumBullets": { "type": "integer", "minimum": 0 },
        "startingWeapon": { "$ref": "#/$defs/id" }
      }
    },
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ammoPerShot", "range", "damageMinimum", "damageMaximum", "damageStep"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ammoPerShot": { "type": "integer", "minimum": 1 },
        "range": { "type": "integer", "minimum": 1 },
        "damageMinimum": { "type": "integer", "minimum": 1 },
        "damageMaximum": { "type": "integer", "minimum": 1 },
        "damageStep": { "type": "integer", "minimum": 1 }
      }
    },
    "combatant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "health", "radius", "height", "behavior"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "health": { "type": "integer", "minimum": 1 },
        "radius": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "behavior": { "$ref": "#/$defs/enemyBehavior" }
      }
    },
    "enemyBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sightRange",
        "attackRange",
        "preferredRange",
        "moveSpeed",
        "reactionMilliseconds",
        "attackIntervalMilliseconds",
        "damage"
      ],
      "properties": {
        "sightRange": { "type": "integer", "minimum": 1 },
        "attackRange": { "type": "integer", "minimum": 1 },
        "preferredRange": { "type": "integer", "minimum": 1 },
        "moveSpeed": { "type": "integer", "minimum": 1 },
        "reactionMilliseconds": { "type": "integer", "minimum": 1 },
        "attackIntervalMilliseconds": { "type": "integer", "minimum": 1 },
        "damage": { "$ref": "#/$defs/damage" }
      }
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "step"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 },
        "step": { "type": "integer", "minimum": 1 }
      }
    },
    "pickup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "resource", "amount", "limit", "radius"],
      "properties": {
        "actor": { "$ref": "#/$defs/id" },
        "resource": { "enum": ["health", "bullets"] },
        "amount": { "type": "integer", "minimum": 1 },
        "limit": { "type": "integer", "minimum": 1 },
        "radius": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
