{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/import-1.json",
  "title": "JScene3D Import Definition version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "source", "importer", "selection"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "pattern": "^asset:.+$"
    },
    "importer": {
      "type": "string"
    },
    "selection": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "settings": {
      "type": "object"
    },
    "itemSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
