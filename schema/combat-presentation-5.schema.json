{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/doomed-corridors/combat-presentation-5.json",
  "title": "Doomed Corridors combat presentation version 5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "weapons", "player", "pickups", "doors", "combatants", "hud"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 5 },
    "weapons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weapon" } },
    "player": { "$ref": "#/$defs/player" },
    "pickups": { "$ref": "#/$defs/pickups" },
    "doors": { "$ref": "#/$defs/doors" },
    "combatants": { "type": "array", "items": { "$ref": "#/$defs/combatant" } },
    "hud": { "$ref": "#/$defs/hud" }
  },
  "$defs": {
    "lump": { "type": "string", "pattern": "^[A-Z0-9]{1,8}$" },
    "lumps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lump" } },
    "weapon": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "readyFrame", "fireFrames", "frameMilliseconds", "fireSound"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "readyFrame": { "$ref": "#/$defs/lump" },
        "fireFrames": { "$ref": "#/$defs/lumps" },
        "frameMilliseconds": { "type": "integer", "minimum": 1 },
        "fireSound": { "$ref": "#/$defs/lump" }
      }
    },
    "player": {
      "type": "object", "additionalProperties": false,
      "required": ["painSound", "deathSound"],
      "properties": { "painSound": { "$ref": "#/$defs/lump" }, "deathSound": { "$ref": "#/$defs/lump" } }
    },
    "pickups": {
      "type": "object", "additionalProperties": false, "required": ["collectSound"],
      "properties": { "collectSound": { "$ref": "#/$defs/lump" } }
    },
    "doors": {
      "type": "object", "additionalProperties": false,
      "required": ["normalOpeningSound", "normalClosingSound", "blazeOpeningSound", "blazeClosingSound"],
      "properties": {
        "normalOpeningSound": { "$ref": "#/$defs/lump" },
        "normalClosingSound": { "$ref": "#/$defs/lump" },
        "blazeOpeningSound": { "$ref": "#/$defs/lump" },
        "blazeClosingSound": { "$ref": "#/$defs/lump" }
      }
    },
    "combatant": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "animations", "sounds"],
      "properties": {
        "actor": { "type": "string" },
        "animations": { "$ref": "#/$defs/animations" },
        "sounds": { "$ref": "#/$defs/sounds" }
      }
    },
    "animations": {
      "type": "object", "additionalProperties": false,
      "required": ["walkFrames", "attackFrames", "painFrames", "deathFrames", "frameMilliseconds"],
      "properties": {
        "walkFrames": { "$ref": "#/$defs/lumps" },
        "attackFrames": { "$ref": "#/$defs/lumps" },
        "painFrames": { "$ref": "#/$defs/lumps" },
        "deathFrames": { "$ref": "#/$defs/lumps" },
        "frameMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "sounds": {
      "type": "object", "additionalProperties": false,
      "required": ["sightSounds", "attackSound", "painSound", "deathSounds"],
      "properties": {
        "sightSounds": { "$ref": "#/$defs/lumps" },
        "attackSound": { "$ref": "#/$defs/lump" },
        "painSound": { "$ref": "#/$defs/lump" },
        "deathSounds": { "$ref": "#/$defs/lumps" }
      }
    },
    "hud": {
      "type": "object", "additionalProperties": false,
      "required": ["digits", "percent"],
      "properties": {
        "digits": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/lump" } },
        "percent": { "$ref": "#/$defs/lump" }
      }
    }
  }
}
