{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jscene3d.org/schemas/project-1.json",
  "title": "JScene3D Project Manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "engine", "runtime", "assets"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "links": {
      "$ref": "#/$defs/links"
    },
    "legal": {
      "$ref": "#/$defs/legal"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "released": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "issues": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression"],
      "properties": {
        "expression": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectLicense": {
          "$ref": "#/$defs/license"
        },
        "thirdPartyNotices": {
          "type": "string"
        },
        "credits": {
          "type": "string"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": {
          "type": "string"
        },
        "authoredWith": {
          "type": "string"
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "target"],
      "properties": {
        "asset": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameProvider", "startup"],
      "properties": {
        "gameProvider": {
          "type": "string"
        },
        "startup": {
          "$ref": "#/$defs/startup"
        },
        "inputMap": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "players": {
          "$ref": "#/$defs/players"
        },
        "contentWarnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
