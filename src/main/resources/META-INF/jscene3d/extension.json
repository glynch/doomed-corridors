{
  "$schema": "https://jscene3d.org/schemas/extension-1.json",
  "schemaVersion": 1,
  "id": "io.github.glynch.doomed-corridors",
  "version": "0.1.0-SNAPSHOT",
  "engineRequires": ">=0.1.0-SNAPSHOT <0.2.0",
  "displayName": "Doomed Corridors",
  "types": [
    {
      "id": "io.github.glynch.doomed-corridors/map-materials-importer",
      "typeVersion": 1,
      "scope": "importer",
      "displayName": "Doom Map Materials"
    },
    {
      "id": "io.github.glynch.doomed-corridors/map-materials",
      "typeVersion": 1,
      "scope": "resource",
      "displayName": "Doom Map Materials",
      "properties": [
        {
          "id": "map",
          "valueKind": "text",
          "required": true,
          "displayName": "Map"
        },
        {
          "id": "wall-textures",
          "valueKind": "array",
          "required": true,
          "displayName": "Wall Textures"
        },
        {
          "id": "flats",
          "valueKind": "array",
          "required": true,
          "displayName": "Flats"
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/doom-level-3d",
      "typeVersion": 1,
      "scope": "scene-node",
      "displayName": "Doom Level 3d",
      "description": "A playable level imported from a Doom-format map.",
      "properties": [
        {
          "id": "map",
          "valueKind": "reference",
          "required": true,
          "displayName": "Map",
          "description": "Imported classic Doom map used to construct this level.",
          "acceptedReferences": ["import"]
        },
        {
          "id": "materials",
          "valueKind": "reference",
          "required": true,
          "displayName": "Materials",
          "description": "Imported wall textures and flats used to render the map.",
          "acceptedReferences": ["import"]
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/doom-player-controller",
      "typeVersion": 1,
      "scope": "node-controller",
      "displayName": "Doom Player Controller",
      "description": "Moves a Doom player nested directly below a Doom level, updates its declared camera, and submits interaction commands to that level.",
      "properties": [
        {
          "id": "camera-node",
          "valueKind": "text",
          "required": true,
          "displayName": "Camera Node",
          "description": "Identifier of the perspective-camera-3d child controlled by the player."
        },
        {
          "id": "pointer-sensitivity",
          "valueKind": "number",
          "required": false,
          "defaultValue": 0.002,
          "displayName": "Pointer Sensitivity",
          "description": "Radians of view rotation applied per pointer-motion unit."
        },
        {
          "id": "move-speed",
          "valueKind": "number",
          "defaultValue": 8,
          "displayName": "Move Speed",
          "description": "Maximum planar movement speed in world units per second.",
          "editor": {"section": "Movement", "minimumExclusive": 0}
        },
        {
          "id": "turn-speed-degrees",
          "valueKind": "number",
          "defaultValue": 180,
          "displayName": "Turn Speed",
          "description": "Keyboard turning speed in degrees per second.",
          "editor": {"section": "View", "minimumExclusive": 0, "unit": "degrees-per-second"}
        },
        {
          "id": "maximum-pitch-degrees",
          "valueKind": "number",
          "defaultValue": 85,
          "displayName": "Maximum Pitch",
          "description": "Maximum upward and downward camera angle in degrees.",
          "editor": {"section": "View", "minimumExclusive": 0, "maximum": 89, "unit": "degrees"}
        }
      ]
    }
  ]
}
