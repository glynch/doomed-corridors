{
  "$schema": "https://jscene3d.org/schemas/extension-1.json",
  "schemaVersion": 1,
  "id": "io.github.glynch.doomed-corridors",
  "version": "0.1.0-SNAPSHOT",
  "engineRequires": ">=0.1.0-SNAPSHOT <0.2.0",
  "displayName": "Doomed Corridors",
  "description": "Doomed Corridors runtime and content integration.",
  "types": [
    {
      "id": "io.github.glynch.doomed-corridors/actors",
      "typeVersion": 1,
      "scope": "importer",
      "displayName": "Doomed Corridors actors"
    }
  ],
  "components": [
    {
      "id": "io.github.glynch.doomed-corridors/player-state",
      "typeVersion": 1,
      "displayName": "Doom Player State",
      "description": "Holds mutable damageable player health and ammunition initialized from provider rules.",
      "providedCapabilities": [
        "io.github.glynch.doomed-corridors/player-resources",
        "io.github.glynch.doomed-corridors/damageable"
      ],
      "properties": [
        {
          "id": "actor-catalog",
          "valueKind": "reference",
          "required": true,
          "displayName": "Actor Catalog",
          "description": "Provider actor catalog used to validate the combat rules.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "combat-rules",
          "valueKind": "reference",
          "required": true,
          "displayName": "Combat Rules",
          "description": "Provider rules supplying initial resources and capacities.",
          "acceptedReferences": ["asset"]
        }
      ],
      "signals": [
        {
          "id": "hurt",
          "displayName": "Hurt",
          "description": "Emitted after non-fatal damage is applied to the player."
        },
        {
          "id": "died",
          "displayName": "Died",
          "description": "Emitted exactly once when player health reaches zero."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/pickup",
      "typeVersion": 1,
      "displayName": "Doom Pickup",
      "description": "Applies one provider-defined resource effect to an overlapping player.",
      "properties": [
        {
          "id": "resource",
          "valueKind": "text",
          "required": true,
          "displayName": "Resource",
          "description": "Player resource changed by this pickup."
        },
        {
          "id": "amount",
          "valueKind": "number",
          "required": true,
          "displayName": "Amount",
          "description": "Maximum resource amount granted by this pickup."
        },
        {
          "id": "limit",
          "valueKind": "number",
          "required": true,
          "displayName": "Limit",
          "description": "Resource ceiling enforced by this pickup type."
        }
      ],
      "actions": [
        {
          "id": "receive-overlap",
          "payload": {
            "type": "io.github.glynch.jscene3d.physics3d/collision-overlap-3d",
            "typeVersion": 1
          },
          "displayName": "Receive Overlap",
          "description": "Receives the pickup sensor's precise overlap transition."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/combatant-state",
      "typeVersion": 1,
      "displayName": "Doom Combatant State",
      "description": "Holds mutable health initialized from one provider combatant definition.",
      "providedCapabilities": [
        "io.github.glynch.doomed-corridors/damageable",
        "io.github.glynch.doomed-corridors/hitscan-target"
      ],
      "requiredCapabilities": ["io.github.glynch.jscene3d.spatial3d/spatial-3d"],
      "properties": [
        {
          "id": "actor-catalog",
          "valueKind": "reference",
          "required": true,
          "displayName": "Actor Catalog",
          "description": "Provider actor catalog used to validate the combat rules.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "combat-rules",
          "valueKind": "reference",
          "required": true,
          "displayName": "Combat Rules",
          "description": "Provider rules supplying the combatant's starting health.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "actor-id",
          "valueKind": "text",
          "required": true,
          "displayName": "Actor",
          "description": "Stable provider actor identity represented by this entity."
        },
        {
          "id": "body",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Body",
          "description": "Explicit solid body removed from physics when this combatant dies."
        }
      ],
      "signals": [
        {
          "id": "hurt",
          "displayName": "Hurt",
          "description": "Emitted after non-fatal damage is applied."
        },
        {
          "id": "died",
          "displayName": "Died",
          "description": "Emitted exactly once when health reaches zero."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/combatant-presentation",
      "typeVersion": 1,
      "displayName": "Doom Combatant Presentation",
      "description": "Presents descriptor-connected movement, attack, pain, and death states using generic billboards and positional audio.",
      "updatePhases": ["frame-update"],
      "properties": [
        {
          "id": "transform",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Transform"
        },
        {
          "id": "idle-frame",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Idle Frame"
        },
        {
          "id": "walk-frames",
          "valueKind": "array",
          "elementKind": "component_target",
          "required": true,
          "displayName": "Walk Frames"
        },
        {
          "id": "attack-frames",
          "valueKind": "array",
          "elementKind": "component_target",
          "required": true,
          "displayName": "Attack Frames"
        },
        {
          "id": "pain-frames",
          "valueKind": "array",
          "elementKind": "component_target",
          "required": true,
          "displayName": "Pain Frames"
        },
        {
          "id": "death-frames",
          "valueKind": "array",
          "elementKind": "component_target",
          "required": true,
          "displayName": "Death Frames"
        },
        {
          "id": "sight-sounds",
          "valueKind": "array",
          "elementKind": "reference",
          "required": true,
          "displayName": "Sight Sounds"
        },
        {
          "id": "attack-sound",
          "valueKind": "reference",
          "required": true,
          "displayName": "Attack Sound",
          "acceptedReferences": ["import"]
        },
        {
          "id": "pain-sound",
          "valueKind": "reference",
          "required": true,
          "displayName": "Pain Sound",
          "acceptedReferences": ["import"]
        },
        {
          "id": "death-sounds",
          "valueKind": "array",
          "elementKind": "reference",
          "required": true,
          "displayName": "Death Sounds"
        },
        {
          "id": "reference-distance",
          "valueKind": "number",
          "required": true,
          "displayName": "Full-volume Distance"
        },
        {
          "id": "maximum-distance",
          "valueKind": "number",
          "required": true,
          "displayName": "Maximum Distance"
        },
        {
          "id": "rolloff-factor",
          "valueKind": "number",
          "required": true,
          "displayName": "Rolloff Factor"
        },
        {
          "id": "frame-milliseconds",
          "valueKind": "number",
          "required": true,
          "displayName": "Frame Duration"
        }
      ],
      "actions": [
        {
          "id": "receive-alerted",
          "displayName": "Receive Alerted",
          "description": "Plays one authored sight-sound variant when the combatant first observes its target."
        },
        {
          "id": "receive-movement-started",
          "displayName": "Receive Movement Started",
          "description": "Starts the authored looping movement animation."
        },
        {
          "id": "receive-movement-stopped",
          "displayName": "Receive Movement Stopped",
          "description": "Returns movement presentation to the appropriate stationary state."
        },
        {
          "id": "receive-attacked",
          "displayName": "Receive Attacked",
          "description": "Starts the authored attack animation and positional sound."
        },
        {
          "id": "receive-hurt",
          "displayName": "Receive Hurt",
          "description": "Starts the authored non-fatal pain reaction."
        },
        {
          "id": "receive-died",
          "displayName": "Receive Died",
          "description": "Starts the authored terminal death reaction."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/enemy-target",
      "typeVersion": 1,
      "displayName": "Doom Enemy Target",
      "description": "Retains the explicitly authored player target shared by an imported actor group.",
      "providedCapabilities": ["io.github.glynch.doomed-corridors/enemy-target"],
      "properties": [
        {
          "id": "player",
          "valueKind": "entity_target",
          "required": true,
          "displayName": "Player",
          "description": "Exact player entity pursued by enemies in this actor group."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/enemy-behavior",
      "typeVersion": 1,
      "displayName": "Doom Enemy Behavior",
      "description": "Observes, pursues, and attacks an explicitly targeted player using provider combat rules.",
      "providedCapabilities": ["io.github.glynch.doomed-corridors/enemy-behavior"],
      "requiredCapabilities": ["io.github.glynch.jscene3d.spatial3d/spatial-3d"],
      "updatePhases": ["before-physics"],
      "properties": [
        {
          "id": "actor-catalog",
          "valueKind": "reference",
          "required": true,
          "displayName": "Actor Catalog",
          "description": "Provider actor catalog used to validate the combat rules.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "combat-rules",
          "valueKind": "reference",
          "required": true,
          "displayName": "Combat Rules",
          "description": "Provider rules supplying awareness, reaction, movement, and attack tuning.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "actor-id",
          "valueKind": "text",
          "required": true,
          "displayName": "Actor",
          "description": "Stable provider enemy identity represented by this entity."
        },
        {
          "id": "target-provider",
          "valueKind": "entity_target",
          "required": true,
          "displayName": "Target Provider",
          "description": "Actor-group entity supplying the exact authored player target."
        },
        {
          "id": "state",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Combatant State",
          "description": "Exact mutable state used to stop behavior after death."
        },
        {
          "id": "body",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Body",
          "description": "Exact character body moved through collision-aware physics."
        }
      ],
      "signals": [
        {
          "id": "alerted",
          "displayName": "Alerted",
          "description": "Emitted exactly once when this enemy first observes its target."
        },
        {
          "id": "movement-started",
          "displayName": "Movement Started",
          "description": "Emitted when this enemy begins requesting collision-aware movement."
        },
        {
          "id": "movement-stopped",
          "displayName": "Movement Stopped",
          "description": "Emitted when this enemy stops requesting collision-aware movement."
        },
        {
          "id": "attacked",
          "displayName": "Attacked",
          "description": "Emitted whenever this enemy executes one provider-authorized attack."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/hitscan-weapon",
      "typeVersion": 1,
      "displayName": "Doom Hitscan Weapon",
      "description": "Consumes player ammunition and applies provider damage to the first solid target on a view ray.",
      "providedCapabilities": ["io.github.glynch.doomed-corridors/weapon"],
      "requiredCapabilities": ["io.github.glynch.doomed-corridors/player-resources"],
      "updatePhases": ["after-physics"],
      "properties": [
        {
          "id": "actor-catalog",
          "valueKind": "reference",
          "required": true,
          "displayName": "Actor Catalog",
          "description": "Provider actor catalog used to validate the combat rules.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "combat-rules",
          "valueKind": "reference",
          "required": true,
          "displayName": "Combat Rules",
          "description": "Provider rules supplying weapon range, cost, and damage.",
          "acceptedReferences": ["asset"]
        },
        {
          "id": "weapon-id",
          "valueKind": "text",
          "required": true,
          "displayName": "Weapon",
          "description": "Stable provider weapon identity fired by this component."
        },
        {
          "id": "view-transform",
          "valueKind": "component_target",
          "required": true,
          "displayName": "View Transform",
          "description": "Explicit transform supplying the weapon's world-space origin and direction."
        },
        {
          "id": "view-camera",
          "valueKind": "component_target",
          "required": true,
          "displayName": "View Camera",
          "description": "Explicit perspective camera supplying the projection used for successful-hit feedback."
        },
        {
          "id": "fire-action",
          "valueKind": "text",
          "required": true,
          "displayName": "Fire Action",
          "description": "Semantic button action which fires one shot when pressed."
        }
      ],
      "signals": [
        {
          "id": "fired",
          "displayName": "Fired",
          "description": "Emitted after ammunition is consumed and one shot is resolved."
        },
        {
          "id": "hit",
          "payload": {
            "type": "io.github.glynch.doomed-corridors/weapon-hit",
            "typeVersion": 1
          },
          "displayName": "Hit",
          "description": "Emitted with the camera-relative impact location when a resolved shot removes health."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/weapon-presentation",
      "typeVersion": 1,
      "displayName": "Doom Weapon Presentation",
      "description": "Displays and animates one first-person weapon and plays its local firing sound.",
      "updatePhases": ["frame-update"],
      "properties": [
        {
          "id": "ready-frame",
          "valueKind": "reference",
          "required": true,
          "displayName": "Ready Frame",
          "description": "Imported overlay texture displayed while idle.",
          "acceptedReferences": ["import"]
        },
        {
          "id": "fire-frames",
          "valueKind": "array",
          "elementKind": "reference",
          "required": true,
          "displayName": "Fire Frames",
          "description": "Ordered imported overlay textures displayed after an accepted shot."
        },
        {
          "id": "fire-sound",
          "valueKind": "reference",
          "required": true,
          "displayName": "Fire Sound",
          "description": "Imported listener-relative PCM firing effect.",
          "acceptedReferences": ["import"]
        },
        {
          "id": "frame-milliseconds",
          "valueKind": "number",
          "required": true,
          "displayName": "Frame Duration",
          "description": "Positive duration of each firing frame in milliseconds."
        },
        {
          "id": "hit-indicator-milliseconds",
          "valueKind": "number",
          "required": true,
          "displayName": "Hit Indicator Duration",
          "description": "Positive duration of the successful-hit indicator in milliseconds."
        }
      ],
      "actions": [
        {
          "id": "receive-fired",
          "displayName": "Receive Fired",
          "description": "Restarts the firing animation and sound for one accepted shot."
        },
        {
          "id": "receive-hit",
          "payload": {
            "type": "io.github.glynch.doomed-corridors/weapon-hit",
            "typeVersion": 1
          },
          "displayName": "Receive Hit",
          "description": "Places and restarts visual confirmation at the successful impact location."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/player-presentation",
      "typeVersion": 1,
      "displayName": "Doom Player Presentation",
      "description": "Presents descriptor-connected player pain and terminal death through local audio and a screen tint.",
      "updatePhases": ["frame-update"],
      "properties": [
        {
          "id": "pain-sound",
          "valueKind": "reference",
          "required": true,
          "displayName": "Pain Sound",
          "description": "Imported listener-relative PCM effect played after non-fatal damage.",
          "acceptedReferences": ["import"]
        },
        {
          "id": "death-sound",
          "valueKind": "reference",
          "required": true,
          "displayName": "Death Sound",
          "description": "Imported listener-relative PCM effect played after terminal damage.",
          "acceptedReferences": ["import"]
        },
        {
          "id": "pain-flash-milliseconds",
          "valueKind": "number",
          "required": true,
          "displayName": "Pain Flash Duration",
          "description": "Positive duration of the non-fatal red response in milliseconds.",
          "editor": {"minimum-exclusive": 0}
        },
        {
          "id": "pain-flash-opacity",
          "valueKind": "number",
          "required": true,
          "displayName": "Pain Flash Opacity",
          "description": "Maximum opacity of the non-fatal red response.",
          "editor": {"minimum-exclusive": 0, "maximum-inclusive": 1}
        },
        {
          "id": "death-flash-milliseconds",
          "valueKind": "number",
          "required": true,
          "displayName": "Death Flash Duration",
          "description": "Positive duration of the terminal red response in milliseconds.",
          "editor": {"minimum-exclusive": 0}
        },
        {
          "id": "death-flash-opacity",
          "valueKind": "number",
          "required": true,
          "displayName": "Death Flash Opacity",
          "description": "Maximum opacity of the terminal red response.",
          "editor": {"minimum-exclusive": 0, "maximum-inclusive": 1}
        },
        {
          "id": "terminal-shade-opacity",
          "valueKind": "number",
          "required": true,
          "displayName": "Terminal Shade Opacity",
          "description": "Persistent dark-shade opacity after the player dies.",
          "editor": {"minimum-inclusive": 0, "maximum-inclusive": 1}
        }
      ],
      "actions": [
        {
          "id": "receive-hurt",
          "displayName": "Receive Hurt",
          "description": "Starts the authored non-fatal pain response."
        },
        {
          "id": "receive-died",
          "displayName": "Receive Died",
          "description": "Starts the authored terminal death response."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/player-lifecycle",
      "typeVersion": 1,
      "displayName": "Doom Player Lifecycle",
      "description": "Disables an explicitly targeted player-controls entity after terminal damage.",
      "properties": [
        {
          "id": "control-entity",
          "valueKind": "entity_target",
          "required": true,
          "displayName": "Control Entity",
          "description": "Exact input-driven entity disabled when the player dies."
        }
      ],
      "actions": [
        {
          "id": "receive-died",
          "displayName": "Receive Died",
          "description": "Applies the terminal lifecycle transition exactly once."
        }
      ]
    },
    {
      "id": "io.github.glynch.doomed-corridors/player-hud",
      "typeVersion": 1,
      "displayName": "Doom Player HUD",
      "description": "Copies player health and ammunition into explicitly targeted generic screen numbers.",
      "updatePhases": ["frame-update"],
      "properties": [
        {
          "id": "player-state",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Player State"
        },
        {
          "id": "health-number",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Health Number"
        },
        {
          "id": "ammo-number",
          "valueKind": "component_target",
          "required": true,
          "displayName": "Ammo Number"
        }
      ]
    }
  ]
}
